{
  "id": "juansync",
  "name": "JuanSync",
  "version": "1.4.0",
  "apiVersion": 14,
  "entry": "plugin.js",
  "description": "Sincroniza tus datos de Kino entre todos tus dispositivos a través de JuanSync.",
  "author": "JuanDEVYT",
  "icon": "icon.png",
  "color": "#000000",
  "theme": {
    "accent": "#FFFFFF",
    "onAccent": "#000000",
    "background": "#000000",
    "surface": "#1A1A1A",
    "highlight": "#8A8A8A"
  },
  "hosts": [
    "juansync.pythonanywhere.com"
  ],
  "capabilities": [
    "syncProvider",
    "screen"
  ],
  "screen": {
    "label": "JuanSync",
    "labelEn": "JuanSync",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsIn": "both",
    "settingsButton": {
      "label": "Abrir JuanSync",
      "labelEn": "Open JuanSync"
    }
  },
  "settings": [
    {
      "key": "needs",
      "type": "help",
      "title": "Cómo funciona",
      "titleEn": "How it works",
      "body": "JuanSync sincroniza tus datos de Kino entre tus dispositivos.\n\n1. Pulsa «Registrarse» para crear tu cuenta.\n2. Para no perder tu cuenta, abre el bot @JuanSync_bot en Telegram y envía:\n   /vincular <tu código>\n3. Si cambias de dispositivo, pulsa «Recuperar cuenta».",
      "bodyEn": "JuanSync syncs your Kino data across your devices.\n\n1. Tap «Register» to create your account.\n2. To secure your account, message @JuanSync_bot on Telegram:\n   /vincular <your code>\n3. If you switch devices, tap «Recover account».",
      "devices": ["phone"]
    },
    {
      "key": "setup",
      "label": "Cuenta",
      "labelEn": "Account",
      "type": "section",
      "devices": ["phone"]
    },
    {
      "key": "token",
      "label": "Token",
      "labelEn": "Token",
      "type": "password",
      "hint": "Se genera al registrarte o pégalo de otro dispositivo",
      "hintEn": "Generated on register or paste from another device",
      "devices": ["phone"]
    },
    {
      "key": "register",
      "label": "Registrarse",
      "labelEn": "Register",
      "type": "action",
      "devices": ["phone"]
    },
    {
      "key": "showLinkCode",
      "label": "Ver código de vinculación",
      "labelEn": "Show linking code",
      "type": "action",
      "devices": ["phone"]
    },
    {
      "key": "recoverSec",
      "label": "Recuperación por Telegram",
      "labelEn": "Telegram Recovery",
      "type": "section",
      "devices": ["phone"]
    },
    {
      "key": "tgUser",
      "label": "Usuario de Telegram",
      "labelEn": "Telegram Username",
      "type": "text",
      "hint": "Ejemplo: mi_usuario (sin @)",
      "hintEn": "Example: my_username (without @)",
      "devices": ["phone"]
    },
    {
      "key": "requestRecover",
      "label": "1. Pedir código a Telegram",
      "labelEn": "1. Request Telegram Code",
      "type": "action",
      "devices": ["phone"]
    },
    {
      "key": "verifyCode",
      "label": "Código recibido",
      "labelEn": "Received Code",
      "type": "text",
      "hint": "Código de 6 dígitos enviado por el bot",
      "hintEn": "6-digit code sent by the bot",
      "devices": ["phone"]
    },
    {
      "key": "confirmRecover",
      "label": "2. Restaurar cuenta",
      "labelEn": "2. Restore Account",
      "type": "action",
      "devices": ["phone"]
    },
    {
      "key": "status",
      "label": "Estado",
      "labelEn": "Status",
      "type": "status"
    },
    {
      "key": "check",
      "label": "Probar conexión",
      "labelEn": "Test connection",
      "type": "action"
    }
  ],
  "sync": {
    "mode": "poll",
    "pullEveryMs": 300000,
    "pushDebounceMs": 60000,
    "maxBlobBytes": 4194304,
    "keySecret": "token",
    "provision": [
      "token"
    ]
  }
}